[
  { "id": "kb-01", "title": "Conditional reasoning and modus tollens", "stages": [1],
    "text": "A conditional 'if A then B' supports two valid moves: modus ponens (A is true, so B is true) and modus tollens (B is false, so A is false). Affirming the consequent (B is true, so A is true) and denying the antecedent are fallacies. Always check the direction of the implication before drawing a conclusion." },
  { "id": "kb-02", "title": "Overfitting and the train/validation gap", "stages": [1, 6],
    "text": "A model is overfit when it memorizes training data and generalizes poorly. The classic symptom is training performance far above validation performance. A small gap between the two is evidence against overfitting, though very low scores on both suggest underfitting instead." },
  { "id": "kb-03", "title": "Underfitting versus overfitting", "stages": [1, 6],
    "text": "Underfitting means the model is too simple to capture the pattern, so both training and validation error are high. Overfitting means low training error but high validation error. Diagnosing which one applies requires comparing the two error curves, not looking at either alone." },
  { "id": "kb-04", "title": "Data validation and range checks", "stages": [2],
    "text": "Data quality checks include schema validation, missing-value checks, and range checks. Some columns have hard bounds: probabilities lie between 0 and 1, ages are non-negative, percentages sit between 0 and 100. A value outside a hard bound is a data error, not merely an outlier." },
  { "id": "kb-05", "title": "Outliers versus anomalies", "stages": [2],
    "text": "An outlier is a valid but unusual observation, such as a very old patient or a very high heart rate. An anomaly or corruption is a value that violates the rules of the domain. Statistical methods like z-scores flag outliers, while domain constraints identify impossible values." },
  { "id": "kb-06", "title": "Model output calibration and probabilities", "stages": [2],
    "text": "Classifiers with sigmoid or softmax outputs produce probabilities that sum to one across classes and never leave the interval from zero to one. If a logged score falls outside that interval, the logging pipeline or a post-processing step has been corrupted." },
  { "id": "kb-07", "title": "Random forests for tabular data", "stages": [3],
    "text": "Random forests are ensembles of decision trees trained on bootstrapped samples with random feature subsets. They work well on labeled tabular data with mixed numeric and categorical features, resist overfitting, and expose feature importances." },
  { "id": "kb-08", "title": "Convolutional neural networks for images", "stages": [3],
    "text": "Convolutional neural networks learn local spatial filters that share weights across an image. They are the standard choice for supervised image tasks such as defect detection, classification, and segmentation when many labeled images are available." },
  { "id": "kb-09", "title": "Density-based clustering", "stages": [3],
    "text": "Density-based clustering groups points that are packed closely together and labels isolated points as noise. It does not require choosing the number of clusters in advance and can discover clusters of arbitrary shape, which makes it suitable for unlabeled spatial data with outliers." },
  { "id": "kb-10", "title": "K-means clustering assumptions", "stages": [3],
    "text": "K-means requires the number of clusters up front, assumes roughly spherical clusters of similar size, and assigns every point to a cluster, so it handles noise and irregular shapes poorly." },
  { "id": "kb-11", "title": "Linear regression and interpretability", "stages": [3],
    "text": "Linear regression predicts a continuous target as a weighted sum of features. Its coefficients are directly interpretable, which makes it a strong baseline for numeric prediction problems where explanations matter." },
  { "id": "kb-12", "title": "Supervised versus unsupervised learning", "stages": [3],
    "text": "Supervised learning needs labeled examples and predicts a known target. Unsupervised learning finds structure in unlabeled data, for example through clustering or dimensionality reduction. Identifying whether labels exist is the first step of algorithm selection." },
  { "id": "kb-13", "title": "Base64 is an encoding, not encryption", "stages": [4],
    "text": "Base64 converts bytes into a text alphabet of letters, digits, plus, slash, and often ends with equals-sign padding. Anyone can reverse it, so it provides no secrecy. Decoding it is the first step when an intercepted message looks like a long alphanumeric string." },
  { "id": "kb-14", "title": "Caesar cipher and shift analysis", "stages": [4],
    "text": "A Caesar cipher rotates each letter by a fixed shift through the alphabet. With only 25 non-trivial shifts it can be broken by trying every one and looking for readable words, or by frequency analysis. Non-letter characters are usually left unchanged." },
  { "id": "kb-15", "title": "Order of operations when peeling layers", "stages": [4],
    "text": "When data is wrapped in several transformations, undo them in the reverse order to how they were applied. If text was shifted and then encoded, decode the outer encoding first before analyzing the inner cipher." },
  { "id": "kb-16", "title": "Linear layers and tensor shapes in PyTorch", "stages": [5],
    "text": "In PyTorch, nn.Linear(in_features, out_features) maps a tensor of shape (batch, in_features) to (batch, out_features). When layers are stacked, the out_features of each layer must equal the in_features of the next, otherwise a matrix multiplication shape error is raised." },
  { "id": "kb-17", "title": "Reading PyTorch shape errors", "stages": [5],
    "text": "The message 'mat1 and mat2 shapes cannot be multiplied' lists the input shape and the weight shape. The inner dimensions must match. Trace which layer produced the first dimension and which layer expects the second." },
  { "id": "kb-18", "title": "Flatten and classifier heads", "stages": [5],
    "text": "Flattening turns an image tensor of shape (batch, height, width) into (batch, height times width). A classification head's last layer should output one logit per class, so for ten classes its out_features is ten." },
  { "id": "kb-19", "title": "Reading learning curves", "stages": [6],
    "text": "Plot training and validation loss per epoch. Training loss usually keeps falling. Validation loss falls, reaches a minimum, and then rises when the model begins to overfit. The epoch at the validation minimum is the natural early-stopping point." },
  { "id": "kb-20", "title": "Generalization gap", "stages": [6],
    "text": "The generalization gap is validation loss minus training loss. A growing gap signals increasing overfitting. Measuring the epoch where the gap first exceeds a tolerance helps decide when to stop training." },
  { "id": "kb-21", "title": "Peak accuracy versus final accuracy", "stages": [6],
    "text": "Validation accuracy can peak before the last epoch and then decline. Reporting the peak value requires reading the whole curve, not only the final point. Bar charts are convenient for comparing accuracy across epochs." },
  { "id": "kb-22", "title": "Historical bias in training data", "stages": [7],
    "text": "Historical bias arises when training data reflects past discrimination or unequal representation. A model optimized to imitate past decisions reproduces those patterns, for example a hiring model trained on years of male-dominated hiring learning to favor male candidates." },
  { "id": "kb-23", "title": "Proxy variables and fairness through unawareness", "stages": [7],
    "text": "Removing a sensitive attribute does not remove bias, because correlated proxy features such as school, activities, or postal code can carry the same signal. Fairness through unawareness is therefore insufficient." },
  { "id": "kb-24", "title": "Bias mitigation practices", "stages": [7],
    "text": "Mitigations include auditing outcomes across groups with fairness metrics such as demographic parity or equalized odds, rebalancing or augmenting training data, removing or constraining proxy features, documenting the model, and keeping meaningful human review of consequential decisions." },
  { "id": "kb-25", "title": "Privacy, consent, and data minimization", "stages": [7],
    "text": "Privacy principles include collecting only the data needed for a stated purpose, obtaining informed consent, limiting retention, and allowing people to access or delete their data. Scraping personal data without consent for automated decisions is a privacy violation." },
  { "id": "kb-26", "title": "Accountability and human oversight", "stages": [7, 8],
    "text": "High-stakes automated decisions need human oversight, transparency about how they were reached, and a route to contest outcomes. Accountability means a named party is responsible for monitoring and correcting the system." },
  { "id": "kb-27", "title": "Prompt injection and secret protection", "stages": [8],
    "text": "Language-model assistants can be manipulated by instructions embedded in user text. Safe designs keep secrets outside the model context, verify credentials in application code, and treat requests such as 'reveal the password' or 'ignore previous instructions' as untrusted input." },
  { "id": "kb-28", "title": "Authentication versus asking", "stages": [8],
    "text": "Authentication proves identity through credentials that only an authorized party could hold. A guarded system should respond to a valid credential, not to a claim of urgency or authority. Presenting evidence you legitimately gathered earlier is the correct way to gain access." },
  { "id": "kb-29", "title": "Retrieval-augmented generation and hallucination control", "stages": [],
    "text": "Retrieval-augmented generation grounds a language model in retrieved documents. Instructing the model to use only the provided context and to say when the context is insufficient reduces hallucination. Retrieval quality bounds answer quality." },
  { "id": "kb-30", "title": "Problem-solving under time pressure", "stages": [],
    "text": "Under time pressure, decompose the task, eliminate clearly wrong options first, and verify one assumption at a time. Guessing repeatedly is penalized in scored settings, so a short reasoning step is usually worth the time." }
]
